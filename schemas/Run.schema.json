{
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "breakdown": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Per-category amounts (input, output, cache, ...).",
          "title": "Breakdown",
          "type": "object"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "fx": {
          "anyOf": [
            {
              "$ref": "#/$defs/FxRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "price_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PriceEntry used, for traceability.",
          "title": "Price Id"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CostStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "Cost",
      "type": "object"
    },
    "CostStatus": {
      "enum": [
        "MEASURED",
        "ESTIMATED",
        "UNKNOWN"
      ],
      "title": "CostStatus",
      "type": "string"
    },
    "FxRate": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "base": {
          "title": "Base",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Rate"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "base",
        "quote",
        "rate",
        "source",
        "as_of"
      ],
      "title": "FxRate",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "ERRORED",
        "TIMEOUT",
        "BUDGET_BLOCKED",
        "CANCELLED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StepKind": {
      "enum": [
        "llm_call",
        "tool_call",
        "decision",
        "retry",
        "error",
        "human",
        "terminal"
      ],
      "title": "StepKind",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cache-write tokens. May be a subset of input_tokens.",
          "title": "Cache Creation Tokens"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cache-read input tokens. May be a subset of input_tokens.",
          "title": "Cached Input Tokens"
        },
        "estimation_granularity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Granularity of the estimate, e.g. 'call', 'step', 'run'.",
          "title": "Estimation Granularity"
        },
        "estimation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when source=ESTIMATED (e.g. 'tiktoken:cl100k_base').",
          "title": "Estimation Method"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "modality_tokens": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Tokens attributed to special modalities (e.g. 'image', 'audio').",
          "title": "Modality Tokens",
          "type": "object"
        },
        "model": {
          "description": "Model identifier as billed by the provider.",
          "title": "Model",
          "type": "string"
        },
        "native_units": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Provider-native billing units for non-token items (e.g. 'images': 2).",
          "title": "Native Units",
          "type": "object"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "provider": {
          "description": "Provider identifier, e.g. 'anthropic', 'openai', 'sim'.",
          "title": "Provider",
          "type": "string"
        },
        "raw": {
          "additionalProperties": true,
          "description": "Provider raw usage payload for audit (secrets redacted).",
          "title": "Raw",
          "type": "object"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reasoning/thinking tokens. May be a subset of output_tokens.",
          "title": "Reasoning Tokens"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/UsageSource"
        },
        "subsets": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Declares inclusion relations, e.g. {'cached_input_tokens': 'input_tokens'} means cached_input is already counted inside input. Drives double-count-safe aggregation.",
          "title": "Subsets",
          "type": "object"
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "required": [
        "provider",
        "model",
        "source"
      ],
      "title": "TokenUsage",
      "type": "object"
    },
    "Trajectory": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "default": false,
          "title": "Completed",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TrajectoryStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "terminal_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal State"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "Trajectory",
      "type": "object"
    },
    "TrajectoryStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Action label (tool name, decision label, 'generate', ...).",
          "title": "Action",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/StepKind"
        },
        "next_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observable state after the action.",
          "title": "Next State"
        },
        "payload_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to the stored artifact (inputs/outputs), if retained.",
          "title": "Payload Ref"
        },
        "retry_of": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Index of the step being retried.",
          "title": "Retry Of"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "description": "Observable state label before the action (adapter-defined).",
          "title": "State",
          "type": "string"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "index",
        "kind",
        "state",
        "action",
        "started_at"
      ],
      "title": "TrajectoryStep",
      "type": "object"
    },
    "UsageSource": {
      "description": "Origin of a token-usage figure (see docs/TOKEN_ACCOUNTING.md).",
      "enum": [
        "REPORTED",
        "ESTIMATED",
        "UNKNOWN"
      ],
      "title": "UsageSource",
      "type": "string"
    }
  },
  "$id": "https://graines.ai/evalkit/schemas/Run.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "title": "Agent Version",
      "type": "string"
    },
    "attempt": {
      "description": "Repetition index within the campaign (1-based).",
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cost"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "output": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inline output if retention allows.",
      "title": "Output"
    },
    "output_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Artifact reference of the output.",
      "title": "Output Ref"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "title": "Scenario Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version this object was produced with.",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Seed handed to stochastic adapters.",
      "title": "Seed"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "PENDING"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "trajectory": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trajectory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/TokenUsage"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "campaign_id",
    "scenario_id",
    "scenario_version",
    "project_id",
    "agent_id",
    "agent_version",
    "attempt"
  ],
  "title": "Run",
  "type": "object"
}
