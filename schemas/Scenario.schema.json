{
  "$defs": {
    "BudgetLimit": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "BudgetLimit",
      "type": "object"
    },
    "Criticality": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "DatasetKind": {
      "description": "DEVELOPMENT data may be used to fix an agent; HOLDOUT is protected and only evaluates.",
      "enum": [
        "DEVELOPMENT",
        "HOLDOUT"
      ],
      "title": "DatasetKind",
      "type": "string"
    },
    "Dimension": {
      "description": "Evaluated dimensions (docs/METRICS.md defines each, its method and its limits).",
      "enum": [
        "accuracy",
        "compliance",
        "completeness",
        "consistency",
        "format",
        "constraints",
        "decision_reliability",
        "tool_use",
        "stability",
        "robustness",
        "security",
        "latency",
        "tokens",
        "cost",
        "business"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "title": "Author",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "origin": {
          "description": "Where the scenario comes from (handwritten, incident replay, ...).",
          "title": "Origin",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "VCS revision or document version.",
          "title": "Revision"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "author",
        "created_at",
        "origin"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SuccessCriteria": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "min_pass_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Pass Rate"
        },
        "required_dimensions": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Required Dimensions",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "SuccessCriteria",
      "type": "object"
    },
    "VerificationSpec": {
      "additionalProperties": false,
      "description": "One verification method applied to the run. Resolved by the evaluator registry.",
      "properties": {
        "blocking": {
          "default": false,
          "description": "If True, a FAIL is eliminatory regardless of other scores.",
          "title": "Blocking",
          "type": "boolean"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "evaluator": {
          "description": "Registered evaluator id, e.g. 'exact_match', 'json_schema'.",
          "title": "Evaluator",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0.0",
          "description": "Contract schema version this object was produced with.",
          "title": "Schema Version",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional scoring weight.",
          "title": "Weight"
        }
      },
      "required": [
        "evaluator",
        "dimension"
      ],
      "title": "VerificationSpec",
      "type": "object"
    }
  },
  "$id": "https://graines.ai/evalkit/schemas/Scenario.schema.json",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
      "title": "Agent Id",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/BudgetLimit"
    },
    "constraints": {
      "description": "Mandatory constraints.",
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "context": {
      "additionalProperties": true,
      "description": "Context and fixtures.",
      "title": "Context",
      "type": "object"
    },
    "criticality": {
      "$ref": "#/$defs/Criticality",
      "default": "MEDIUM"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetKind",
      "default": "DEVELOPMENT"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "expected_behavior": {
      "title": "Expected Behavior",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": true,
      "description": "Inputs handed to the adapter.",
      "title": "Inputs",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reference_outputs": {
      "additionalProperties": true,
      "description": "Ground-truth references used by evaluators.",
      "title": "Reference Outputs",
      "type": "object"
    },
    "repetitions": {
      "default": 1,
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "scenario_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "description": "Contract schema version this object was produced with.",
      "title": "Schema Version",
      "type": "string"
    },
    "sources_of_truth": {
      "items": {
        "type": "string"
      },
      "title": "Sources Of Truth",
      "type": "array"
    },
    "success": {
      "$ref": "#/$defs/SuccessCriteria"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "verifications": {
      "items": {
        "$ref": "#/$defs/VerificationSpec"
      },
      "minItems": 1,
      "title": "Verifications",
      "type": "array"
    },
    "version": {
      "description": "Scenario version (semver). Changing expectations bumps it.",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "version",
    "project_id",
    "agent_id",
    "name",
    "description",
    "objective",
    "inputs",
    "expected_behavior",
    "verifications",
    "provenance"
  ],
  "title": "Scenario",
  "type": "object"
}
